{
  "name": "chinese-aesthetic-skill",
  "version": "1.0.0",
  "description": "东方空间美学决策引擎 — 10个可执行核心引擎，回答\"这个设计为什么是中国的\"",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "test": "node tests/engines.test.js && npm run test:rules && npm run test:docs && npm run lint:rules && npm run lint:docs && npm run lint:conflicts",
    "test:engines": "node tests/engines.test.js",
    "test:rules": "node --test tests/rules/*.test.js",
    "test:docs": "node --test tests/docs/*.test.js",
    "lint:rules": "node scripts/lint-rules.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:conflicts": "node scripts/lint-conflicts.mjs",
    "docs:render": "node scripts/render-rules-docs.mjs --write",
    "docs:check": "node scripts/render-rules-docs.mjs --check && node scripts/evidence.mjs --check",
    "evidence": "node scripts/evidence.mjs",
    "emit:sheet": "node scripts/emit-sheet.mjs",
    "test:gates": "node scripts/validate.cjs",
    "gate1": "node scripts/validate.cjs --gate 1",
    "gate2": "node scripts/validate.cjs --gate 2",
    "gate3": "node scripts/validate.cjs --gate 3",
    "validate": "node scripts/validate.cjs --input"
  },
  "keywords": ["chinese-aesthetic", "eastern-aesthetic", "design-engine", "decision-engine", "heartmirror", "three.js", "spatial-order", "void-solid"],
  "author": "HEARTMIRROR Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanjun88/chinese-aesthetic-skill.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "comment_dependencies": "lib/ 引擎层零运行时依赖（纯 ESM，只 import 本仓库的 rules/ 登记簿 JSON）。下列 React 系依赖仅供 src/ 的 Vite UI demo 使用，运行时不需要。",
  "devDependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
