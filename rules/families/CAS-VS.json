        "SRC-DC-GOLDEN-MATRIX"
      ],
      "payload": {
        "parameter": "scene.composition.negativeSpaceRatio",
        "ir_pointer": "/composition/negativeSpaceRatio",
        "metric": "void_ratio",
        "semantics": "PERIOD_BAND",
        "min": 0.15,
        "max": 0.4,
        "unit": "ratio",
        "rationale": "唐代雄浑巨构，建筑主体占据画面，留白比例较低. Band spans the documented prior and the sealed TANG golden cells (0.15, 0.20, 0.28)."
      }
    },
