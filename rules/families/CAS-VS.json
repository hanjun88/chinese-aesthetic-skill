{
  "family": "CAS-VS",
  "description": "Void / solid (留白): the canonical definition of void_ratio and every threshold expressed in it. See docs/decisions/ADR-0001-negative-space.md.",
  "rules": [
    {
      "rule_id": "CAS-VS-PR-001",
      "title": "void_ratio is a ratio",
      "kind": "PARAMETER_BAND",
      "role": "composition",
      "confidence": 1,
      "sources": [
        "SRC-ADR-0001"
      ],
      "payload": {
        "parameter": "scene.composition.negativeSpaceRatio",
        "ir_pointer": "/composition/negativeSpaceRatio",
        "metric": "void_ratio",
        "semantics": "PHYSICAL_RANGE",
        "min": 0,
        "max": 1,
        "unit": "ratio",
        "rationale": "void_ratio is the designed-void share of the frame; a share cannot leave [0, 1]. /composition/negativeSpaceRatio in the Core IR means void_ratio (design-level), its pixel estimator is a lower bound."
      }
    },
    {
      "rule_id": "CAS-VS-HF-001",
      "title": "Hard floor: bright-tone landscape void >= 60%",
      "kind": "PARAMETER_BAND",
      "role": "composition",
      "confidence": 0.9,
      "applies_to": {
        "scene_type": [
          "LANDSCAPE"
        ],
        "lighting": [
          "DAYLIGHT"
        ]
      },
      "sources": [
        "SRC-GUIDE-VOID-SOLID-METRICS",
        "SRC-GUIDE-VOID-SOLID-P0"
      ],
      "payload": {
        "parameter": "scene.composition.negativeSpaceRatio",
        "ir_pointer": "/composition/negativeSpaceRatio",
        "metric": "void_ratio",
        "semantics": "HARD_FLOOR",
        "min": 0.6,
        "max": 1,
        "unit": "ratio",
        "rationale": "留白面积比 >= 60%（硬阈值，亮调可推到60-70%）: P0 for bright-tone cinematic empty shots / landscape. Dark-tone scenes substitute 20-40% dark solids and are outside this floor."
      }
    },
    {
      "rule_id": "CAS-VS-PB-TANG",
      "title": "TANG void_ratio band",
      "kind": "PARAMETER_BAND",
      "role": "composition",
      "confidence": 0.65,
      "applies_to": {
