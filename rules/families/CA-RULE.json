{
  "family": "CA-RULE",
  "description": "Classical-treatise grammar rules (虚实相生 / 气韵生动 / 苍润 / 设色 / 静墨) expressed as Core IR repair rules. Thresholds that have a period band are derived from it.",
  "rules": [
    {
      "rule_id": "CA-RULE-01-XUSHI",
      "title": "虚实相生: restore void when the composition is over-full",
      "kind": "GRAMMAR_RULE",
      "role": "composition",
      "confidence": 0.7,
      "sources": [
        "SRC-DC-GRAMMAR-RULES-V1",
        "SRC-ADR-0001",
        "SRC-DC-STEP7-WHITEPAPER"
      ],
      "payload": {
        "principle": "虚实相生",
        "category": "composition",
        "description": "Trigger is the lower edge of the context's effective void_ratio band; the authored repair target 0.45 is clamped into that band. Also carries the intent of the former ANTI-AI-02 (over-full AI composition), merged by ADR-0001.",
        "target_path": "/composition/negativeSpaceRatio/value",
        "condition": {
          "operator": "<",
          "value": {
            "$band": {
              "parameter": "scene.composition.negativeSpaceRatio",
              "edge": "min"
            }
          }
        },
        "mutation": {
          "op": "replace",
          "value": {
            "$clamp": {
              "value": 0.45,
              "parameter": "scene.composition.negativeSpaceRatio"
            }
          }
        },
        "severity": "P1_WARNING",
        "reason": "恢复东方美学留白呼吸感，避免构图过满"
      }
    },
    {
      "rule_id": "CA-RULE-02-YUNRUN",
