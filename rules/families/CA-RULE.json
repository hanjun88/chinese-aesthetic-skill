        "mutation": {
          "op": "replace",
          "value": 0.75
        },
        "severity": "P1_WARNING",
        "reason": "柔化主光边缘，营造氤氲气韵，避免硬光切割"
      }
    },
    {
      "rule_id": "CA-RULE-03-CANGRUN",
