      "sources": [
        "SRC-DC-GRAMMAR-RULES-V1"
      ],
      "payload": {
        "principle": "气韵生动",
        "category": "lighting",
        "target_path": "/lighting/keyLight/softness/value",
        "condition": {
          "operator": "<",
          "value": 0.5
