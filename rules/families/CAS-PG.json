  "rules": [
    {
      "rule_id": "CAS-PG-PERIOD-PRINCIPLES",
      "title": "Period mother grammar: the aesthetic principles in force per period",
      "kind": "OPERATION_POLICY",
      "role": "governance",
      "confidence": 0.65,
      "sources": [
        "SRC-DC-PERIOD-GRAMMAR"
      ],
      "payload": {
        "subject": "PERIOD_PRINCIPLES",
        "params": {},
        "lists": {
          "principles": {
            "$by_period": {
              "TANG": [
                "GUEST_HOST_COMITY",
                "SCALE_PROPORTION",
                "POSITION_MANAGEMENT",
                "MATERIAL_PATINA"
              ],
              "SONG": [
                "VOID_SOLID_INTERPLAY",
                "COUNT_WHITE_AS_BLACK",
                "LIGHT_TEMPORALITY",
                "QI_YUN_CONTINUITY"
              ],
              "MING": [
                "POSITION_MANAGEMENT",
                "GUEST_HOST_COMITY",
                "MATERIAL_PATINA",
                "SCALE_PROPORTION"
              ]
            }
          }
        },
        "rationale": "TANG 宾主揖让/尺度气势/经营位置/材质时间 (雄浑巨构、中轴对称、金石包浆); SONG 虚实相生/计白当黑/光照天时/气韵贯通 (山水意境、留白、烟雨清润); MING 经营位置/宾主揖让/材质时间/尺度气势 (简雅秩序、文房主次、木器包浆)."
      }
    },
